             <item><layout class="QHBoxLayout" name="actionLayout"><item><spacer name="actionSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="btnClearTodo"><property name="text"><string>Clear form</string></property><property name="minimumSize"><size><width>125</width><height>42</height></size></property></widget></item><item><widget class="QPushButton" name="btnSubmitTodo"><property name="text"><string>＋ Add ToDo</string></property><property name="minimumSize"><size><width>145</width><height>42</height></size></property></widget></item></layout></item>
