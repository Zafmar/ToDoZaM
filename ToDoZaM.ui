<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainMenu</class>
 <widget class="QMainWindow" name="MainMenu">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1360</width><height>860</height></rect>
  </property>
  <property name="minimumSize"><size><width>1050</width><height>680</height></size></property>
  <property name="windowTitle"><string>ToDoZaM</string></property>
  <property name="styleSheet">
   <string notr="true">/* ===== ToDoZaM light / modern theme ===== */
QMainWindow, QWidget#centralwidget { background: #F4F7F8; color: #25343A; font-family: "Segoe UI", Arial, sans-serif; }

QFrame#sidebar { background: #24343A; border: 0; }
QLabel#lblBrand { color: #FFFFFF; font-size: 28px; font-weight: 900; background: transparent; }
QLabel#lblBrandSub { color: #AFC2C7; font-size: 11px; font-weight: 600; background: transparent; }
QLabel#lblSidebarSection { color: #7F989F; font-size: 10px; font-weight: 800; letter-spacing: 1px; background: transparent; }
QLabel#lblSidebarFooter { color: #82989E; font-size: 10px; background: transparent; }

QPushButton[class="navButton"] {
    background: transparent; color: #CFDADD; border: 0; border-radius: 12px;
    text-align: left; padding: 12px 16px; min-height: 24px; font-size: 13px; font-weight: 650;
}
QPushButton[class="navButton"]:hover { background: #30464D; color: #FFFFFF; }
QPushButton[class="navButton"][active="true"] { background: #DDEBE8; color: #204039; font-weight: 850; }

QFrame#topHeader { background: #F4F7F8; border: 0; }
QLabel#lblHeaderTitle { color: #23333A; font-size: 27px; font-weight: 850; background: transparent; }
QLabel#lblHeaderSubtitle { color: #667981; font-size: 12px; background: transparent; }
QLabel#lblToday { color: #63767E; font-size: 12px; font-weight: 650; background: transparent; }

QStackedWidget#stackedWidget { background: #F4F7F8; border: 0; }
QScrollArea { background: transparent; border: 0; }
QScrollArea > QWidget > QWidget { background: transparent; }

QFrame.card { background: #FFFFFF; border: 1px solid #D8E2E5; border-radius: 18px; }
QFrame.sectionCard { background: #FFFFFF; border: 1px solid #D8E2E5; border-radius: 16px; }
QFrame.accentSage { background: #6F9488; border: 0; border-radius: 3px; min-height: 6px; max-height: 6px; }
QFrame.accentBlue { background: #6E86B7; border: 0; border-radius: 3px; min-height: 6px; max-height: 6px; }
QFrame.accentRose { background: #B97878; border: 0; border-radius: 3px; min-height: 6px; max-height: 6px; }

QLabel.pageTitle { color: #25343A; font-size: 23px; font-weight: 850; background: transparent; }
QLabel.pageText { color: #61747C; font-size: 12px; background: transparent; }
QLabel.sectionTitle { color: #2D4148; font-size: 15px; font-weight: 800; background: transparent; }
QLabel.fieldLabel { color: #455A62; font-size: 11px; font-weight: 700; background: transparent; }
QLabel.helperText { color: #7B8D94; font-size: 10px; background: transparent; }
QLabel.systemValue { color: #35515B; font-size: 12px; font-weight: 750; background: #F5F9F8; border: 1px solid #D8E6E2; border-radius: 9px; padding: 8px 10px; }

QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox {
    background: #FBFCFC; color: #263A42; border: 1px solid #C9D7DB; border-radius: 9px;
    min-height: 35px; padding: 0 10px; font-size: 12px; selection-background-color: #CFE1DC;
}
QTextEdit { padding: 8px 10px; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus { border: 2px solid #6F9488; background: #FFFFFF; }
QComboBox::drop-down, QDateEdit::drop-down { width: 26px; border: 0; }
QCheckBox { color: #536971; spacing: 7px; font-size: 11px; }
QCheckBox::indicator { width: 16px; height: 16px; }

QPushButton#btnSubmitTodo { background: #587F73; color: #FFFFFF; border: 0; border-radius: 11px; padding: 10px 22px; min-height: 24px; font-size: 13px; font-weight: 850; }
QPushButton#btnSubmitTodo:hover { background: #4C7166; }
QPushButton#btnSubmitTodo:pressed { background: #3E5F56; }
QPushButton#btnClearTodo { background: #EDF2F3; color: #40555D; border: 1px solid #D1DDE0; border-radius: 11px; padding: 10px 20px; min-height: 24px; font-size: 13px; font-weight: 750; }
QPushButton#btnClearTodo:hover { background: #E2E9EB; }

QFrame.placeholderCard { background: #FFFFFF; border: 1px solid #D8E2E5; border-radius: 18px; }
QLabel.placeholderIcon { color: #6F9488; font-size: 42px; font-weight: 900; background: transparent; }
QLabel.placeholderTitle { color: #263A42; font-size: 22px; font-weight: 850; background: transparent; }
QLabel.placeholderText { color: #667B83; font-size: 12px; background: transparent; }

QTableWidget { background: #FFFFFF; alternate-background-color: #F7F9FA; border: 1px solid #D8E2E5; border-radius: 12px; gridline-color: #E7ECEE; selection-background-color: #DDEBE8; selection-color: #23343A; }
QHeaderView::section { background: #E7EFED; color: #344950; border: 0; border-right: 1px solid #D6E1DF; padding: 8px; font-weight: 750; }
</string>
